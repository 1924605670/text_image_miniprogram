.screen {
  min-height: 100vh;
  padding: 28rpx;
}

.hero,
.panel,
.result,
.job-card {
  border: 1rpx solid #dce1e8;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 36rpx rgba(29, 38, 61, 0.08);
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 28rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  color: #69707d;
  font-size: 22rpx;
  font-weight: 900;
  text-transform: uppercase;
}

.title {
  display: block;
  color: #15181d;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.15;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #69707d;
  font-size: 25rpx;
  line-height: 1.5;
}

.health,
.status-pill {
  flex: 0 0 auto;
  min-width: 132rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid #f1c58f;
  border-radius: 999rpx;
  color: #9a4f0a;
  background: #fff7ed;
  text-align: center;
  font-size: 22rpx;
  font-weight: 900;
}

.health.ok,
.status-pill {
  border-color: #b8ded5;
  color: #0f5e3f;
  background: #e6f4f1;
}

.panel,
.result,
.history-section {
  margin-top: 22rpx;
}

.panel,
.result {
  padding: 24rpx;
}

.panel-head,
.result-head,
.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.panel-title,
.section-title,
.block-title {
  display: block;
  color: #15181d;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.2;
}

.text-action,
.link-button {
  min-width: 116rpx;
  height: 60rpx;
  border: 1rpx solid #dce1e8;
  border-radius: 999rpx;
  color: #0f766e;
  background: #ffffff;
  text-align: center;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 60rpx;
}

.field {
  margin-top: 22rpx;
}

.field > text {
  display: block;
  margin-bottom: 10rpx;
  color: #69707d;
  font-size: 24rpx;
  font-weight: 900;
}

input,
textarea {
  width: 100%;
  border: 1rpx solid #dce1e8;
  border-radius: 16rpx;
  color: #15181d;
  background: #ffffff;
  font-size: 26rpx;
}

input {
  height: 78rpx;
  padding: 0 18rpx;
}

textarea {
  min-height: 300rpx;
  padding: 18rpx;
  line-height: 1.55;
}

.quick-settings {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 18rpx;
}

.chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #0f5e3f;
  background: #e6f4f1;
  font-size: 23rpx;
  font-weight: 900;
}

.link-button {
  border-color: transparent;
  background: transparent;
}

.advanced-panel,
.optimized-card {
  margin-top: 22rpx;
  padding: 18rpx;
  border: 1rpx solid #e8edf3;
  border-radius: 16rpx;
  background: #f8fafc;
}

.picker-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.select {
  min-height: 88rpx;
  border: 1rpx solid #dce1e8;
  border-radius: 12rpx;
  padding: 12rpx;
  background: #ffffff;
}

.select text {
  display: block;
  color: #69707d;
  font-size: 20rpx;
  font-weight: 900;
}

.select view {
  margin-top: 6rpx;
  color: #15181d;
  font-size: 24rpx;
  font-weight: 900;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: 12rpx;
  margin-top: 24rpx;
}

.result-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.primary,
.secondary,
.use-button {
  height: 92rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: #0f766e;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.secondary,
.use-button {
  border: 1rpx solid #0f766e;
  color: #0f766e;
  background: #ffffff;
}

.use-button {
  width: 100%;
  height: 76rpx;
  margin-top: 16rpx;
  font-size: 25rpx;
  line-height: 76rpx;
}

.compact-button {
  height: 72rpx;
  font-size: 24rpx;
  line-height: 72rpx;
}

.primary[disabled],
.secondary[disabled] {
  opacity: 0.66;
}

.prompt-text,
.result-prompt {
  margin-top: 14rpx;
  padding: 18rpx;
  border-left: 6rpx solid #0f766e;
  border-radius: 10rpx;
  color: #15181d;
  background: #ffffff;
  font-size: 25rpx;
  line-height: 1.6;
}

.result-prompt {
  border-left-color: #dce1e8;
  color: #69707d;
  background: #f8fafc;
}

.error,
.empty {
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #f0c8c8;
  border-radius: 12rpx;
  color: #b64040;
  background: #fff0f2;
  font-size: 24rpx;
  line-height: 1.5;
}

.empty {
  border-style: dashed;
  border-color: #dce1e8;
  color: #69707d;
  background: rgba(255, 255, 255, 0.66);
  text-align: center;
}

.inline-error {
  margin-top: 16rpx;
}

.preview {
  width: 100%;
  height: 620rpx;
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #eef2f7;
}

.section-row {
  margin: 30rpx 0 16rpx;
}

.job-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 150rpx;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 14rpx;
  padding: 18rpx;
}

.job-main {
  min-width: 0;
}

.job-card text {
  display: block;
  color: #15181d;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.job-card view view {
  margin-top: 8rpx;
  color: #69707d;
  font-size: 22rpx;
}

.job-card .job-hint {
  color: #0f766e;
  font-weight: 800;
}

.job-card image {
  width: 150rpx;
  height: 100rpx;
  border-radius: 10rpx;
  background: #eef2f7;
}

.retry-mini {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  min-width: 92rpx;
  height: 46rpx;
  border: 1rpx solid #f0c8c8;
  border-radius: 999rpx;
  color: #b64040;
  background: #fff0f2;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 46rpx;
}
