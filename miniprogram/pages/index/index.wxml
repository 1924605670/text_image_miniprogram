<view class="screen">
  <view class="hero">
    <view>
      <text class="eyebrow">Text to Image</text>
      <text class="title">AI 文生图</text>
      <text class="subtitle">只做一件事：把想法稳定生成好看的图片。</text>
    </view>
    <view class="health {{healthOk ? 'ok' : 'warn'}}">{{healthText}}</view>
  </view>

  <view class="panel input-panel">
    <view class="panel-head">
      <view>
        <text class="eyebrow">Prompt</text>
        <text class="panel-title">提示词</text>
      </view>
      <button class="text-action" bindtap="useDemo">填入示例</button>
    </view>

    <view class="field">
      <textarea value="{{prompt}}" data-field="prompt" maxlength="4000" placeholder="直接描述画面：主体、场景、构图、光线、材质、情绪。越具体，成图越稳。" bindinput="bindInput"></textarea>
    </view>

    <view class="quick-settings">
      <view class="chip">{{stylePresetLabel}}</view>
      <view class="chip">{{sizeLabel}}</view>
      <view class="chip">{{qualityLabel}}</view>
      <button class="link-button" bindtap="toggleAdvanced">{{advancedOpen ? '收起设置' : '更多设置'}}</button>
    </view>

    <view wx:if="{{advancedOpen}}" class="advanced-panel">
      <view class="picker-grid">
        <picker mode="selector" range="{{stylePresets}}" value="{{stylePresetIndex}}" bindchange="changeStylePreset">
          <view class="select"><text>风格</text><view>{{stylePresetLabel}}</view></view>
        </picker>
        <picker mode="selector" range="{{sizes}}" value="{{sizeIndex}}" bindchange="changeSize">
          <view class="select"><text>尺寸</text><view>{{sizeLabel}}</view></view>
        </picker>
        <picker mode="selector" range="{{qualities}}" value="{{qualityIndex}}" bindchange="changeQuality">
          <view class="select"><text>质量</text><view>{{qualityLabel}}</view></view>
        </picker>
      </view>

      <view class="field">
        <text>负面提示词</text>
        <input value="{{negativePrompt}}" data-field="negativePrompt" placeholder="可选：不想出现的内容，如水印、变形、模糊" bindinput="bindInput" />
      </view>
    </view>

    <view class="actions">
      <button class="secondary" loading="{{optimizing}}" disabled="{{optimizing || creating}}" bindtap="optimizePrompt">
        {{optimizing ? '优化中' : '优化提示词'}}
      </button>
      <button class="primary" loading="{{creating}}" disabled="{{creating || optimizing}}" bindtap="createImage">
        {{creating ? '生成中' : '生成图片'}}
      </button>
    </view>

    <view wx:if="{{optimizedPrompt}}" class="optimized-card">
      <view class="section-row">
        <text class="block-title">优化后的提示词</text>
        <button class="text-action" bindtap="copyPrompt">复制</button>
      </view>
      <view class="prompt-text">{{optimizedPrompt}}</view>
      <button class="use-button" bindtap="useOptimizedPrompt">使用这个提示词</button>
    </view>

    <view wx:if="{{error}}" class="error">{{error}}</view>
  </view>

  <view wx:if="{{imageJob}}" id="result-card" class="result">
    <view class="result-head">
      <view>
        <text class="eyebrow">Result</text>
        <text class="panel-title">生成结果</text>
      </view>
      <view class="status-pill">{{jobStatusText}}</view>
    </view>

    <image wx:if="{{imageUrl}}" class="preview" mode="aspectFit" src="{{imageUrl}}" bindtap="previewImage"></image>
    <view wx:elif="{{imageJob.status === 'failed'}}" class="error inline-error">{{imageJob.error || '图片生成失败'}}</view>
    <view wx:else class="empty">图片正在生成，请稍等...</view>

    <view class="result-actions">
      <button class="secondary compact-button" bindtap="copyResultPrompt">复制提示词</button>
      <button wx:if="{{resultImageUrl}}" class="secondary compact-button" bindtap="copyImageUrl">复制图片链接</button>
      <button wx:if="{{imageJob.status === 'failed'}}" class="secondary compact-button" data-id="{{imageJob.id}}" bindtap="retryJob">重试</button>
    </view>

    <view class="result-prompt">{{imageJob.final_prompt || imageJob.prompt}}</view>
  </view>

  <view class="history-section">
    <view class="section-row">
      <text class="section-title">最近生成</text>
      <button class="text-action" bindtap="loadHistory">刷新</button>
    </view>
    <view wx:if="{{recentJobs.length === 0}}" class="empty">暂无图片任务</view>
    <view wx:for="{{recentJobs}}" wx:key="id" class="job-card">
      <view class="job-main" data-id="{{item.id}}" bindtap="reuseJob">
        <text>{{item.prompt}}</text>
        <view>{{item.createdAt}} · {{item.statusText}} · {{item.styleLabel}} · {{item.sizeLabel}}</view>
        <view class="job-hint">点按复用提示词</view>
      </view>
      <image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" data-url="{{item.imageUrl}}" mode="aspectFill" catchtap="openHistoryImage"></image>
      <button wx:if="{{item.status === 'failed'}}" class="retry-mini" data-id="{{item.id}}" catchtap="retryJob">重试</button>
    </view>
  </view>
</view>
