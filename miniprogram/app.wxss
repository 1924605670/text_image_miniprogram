page {
  min-height: 100vh;
  background: #f6f7fb;
  color: #1c1d1f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  padding: 0;
  border-radius: 0;
  background: transparent;
}

button::after {
  border: 0;
}
